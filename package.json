{
  "name": "ccflaky",
  "version": "0.1.1",
  "description": "Which tools Claude actually uses — and which ones silently fail on you.",
  "bin": {
    "ccflaky": "bin/ccflaky.js"
  },
  "scripts": {
    "test": "node test/test.js",
    "sync-vendor": "node ../tools/sync-vendor.js",
    "prepublishOnly": "if [ -f ../tools/sync-vendor.js ]; then npm run sync-vendor && git diff --exit-code lib/vendor; fi && npm test"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE",
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "tools",
    "analytics",
    "debugging",
    "cli"
  ],
  "license": "MIT",
  "author": "sue738",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sue738/ccflaky.git"
  },
  "homepage": "https://github.com/sue738/ccflaky#readme",
  "bugs": {
    "url": "https://github.com/sue738/ccflaky/issues"
  }
}
